---
layout: default
---
<div class="retro-mac-page">
  <!-- Date display -->
  <div id="mac-date"></div>

  <!-- Mac icon -->
  <div id="mac-icon">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 4H20V16H4V4Z" fill="white" stroke="black" stroke-width="2"/>
      <path d="M8 16V20H16V16" stroke="black" stroke-width="2"/>
      <path d="M6 20H18" stroke="black" stroke-width="2"/>
    </svg>
  </div>

  <!-- Top row: Now Playing + Visualizer -->
  <div class="toprow">
    <!-- Now Playing Window -->
    <div class="nowplaying mac-window glow-card">
      <span class="glow"></span>
      <div class="dragarea"></div>
      <h3>Now Playing</h3>
      <div class="np-content">
        <div class="np-display">
          <h4 id="current-artist">{{ site.author.name | default: "Ting Xu" }}</h4>
          <h4 id="current-song">Select a track</h4>
        </div>
        <div class="np-controls">
          <button id="prev-track" aria-label="Previous track">&#8249; Prev</button>
          <button id="next-track" aria-label="Next track">Next &#8250;</button>
        </div>
      </div>
    </div>

    <!-- Visualizer Window -->
    <div class="analyzer mac-window glow-card">
      <span class="glow"></span>
      <div class="dragarea"></div>
      <h3>Visualizer</h3>
      <div class="analyzer-bars">
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
      </div>
    </div>
  </div>

  <!-- Album Window -->
  <div class="window mac-window album-window glow-card">
    <span class="glow"></span>
    <div class="dragarea"></div>
    <h3>{{ page.title | default: "Music Collection" }}</h3>
    <div class="frame">
      <!-- Album Covers -->
      <div class="imgwrap">
        {% assign musics = site.musics | sort: 'composition_time' | reverse %}
        {% for music in musics limit: 10 %}
          <img
            src="{{ music.image | relative_url }}"
            alt="{{ music.title }}"
            class="{% if forloop.first %}active{% endif %}"
            data-index="{{ forloop.index0 }}"
          >
        {% endfor %}
      </div>

      <!-- Track List -->
      <div class="tracklist">
        <ul>
          {% for music in musics limit: 10 %}
            <li>
              <a
                href="{{ music.url | relative_url }}"
                class="track-link {% if forloop.first %}active{% endif %}"
                data-index="{{ forloop.index0 }}"
                data-title="{{ music.title }}"
                data-artist="{{ music.author | default: site.author.name }}"
                data-soundcloud="{{ music.soundcloud_url }}"
                data-description="{{ music.description }}"
              >
                {{ music.author | default: "Ting Xu" }} - <span>{{ music.title }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  <!-- Player Window (SoundCloud Embed) -->
  <div class="player-window mac-window glow-card">
    <span class="glow"></span>
    <div class="dragarea"></div>
    <h3>Player</h3>
    <div class="player-content">
      <div id="soundcloud-player">
        {% assign first_music = musics | first %}
        {% if first_music.soundcloud_url %}
          <iframe
            id="sc-widget"
            width="100%"
            height="166"
            scrolling="no"
            frameborder="no"
            allow="autoplay"
            src="{{ first_music.soundcloud_url }}"
          ></iframe>
        {% else %}
          <p>No track selected</p>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- SVG Dither Filter -->
  <svg class="dither-svg">
    <filter color-interpolation-filters="sRGB" height="100%" id="dither" width="100%" x="0" y="0">
      <feImage height="4" width="4" href="data:image/png;base64,"></feImage>
      <feTile></feTile>
      <feComposite in="SourceGraphic" k1="0" k2="1" k3="1" k4="-0.5" operator="arithmetic"></feComposite>
      <feComponentTransfer>
        <feFuncR tableValues="0 1" type="discrete"></feFuncR>
        <feFuncG tableValues="0 1" type="discrete"></feFuncG>
        <feFuncB tableValues="0 1" type="discrete"></feFuncB>
      </feComponentTransfer>
    </filter>
  </svg>
</div>

<!-- GSAP for Draggable -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/Draggable.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Date display
  const dt = new Date();
  const dateEl = document.getElementById('mac-date');
  if (dateEl) {
    dateEl.textContent = dt.toLocaleString('en-us', { weekday: 'short' }) + ' ' +
                         dt.toLocaleString('default', { month: 'short' }) + ' ' +
                         dt.getDate();
  }

  // Make windows draggable
  if (typeof Draggable !== 'undefined') {
    Draggable.create('.mac-window', {
      trigger: '.dragarea',
      bounds: '.retro-mac-page',
      type: 'x,y',
      inertia: true,
      onDragStart: function() {
        // Bring window to front
        document.querySelectorAll('.mac-window').forEach(w => w.style.zIndex = 999);
        this.target.style.zIndex = 1000;
      }
    });
  }

  // Track selection
  const tracks = document.querySelectorAll('.track-link');
  const images = document.querySelectorAll('.imgwrap img');
  const artistDisplay = document.getElementById('current-artist');
  const songDisplay = document.getElementById('current-song');
  const scPlayer = document.getElementById('sc-widget');
  let currentIndex = 0;

  function previewTrack(index) {
    // Update active states visually
    tracks.forEach(t => t.classList.remove('active'));
    images.forEach(i => i.classList.remove('active'));

    if (tracks[index]) {
      tracks[index].classList.add('active');
      images[index]?.classList.add('active');

      // Update display
      artistDisplay.textContent = tracks[index].dataset.artist;
      songDisplay.textContent = tracks[index].dataset.title;

      // Update SoundCloud player
      if (scPlayer && tracks[index].dataset.soundcloud) {
        scPlayer.src = tracks[index].dataset.soundcloud;
      }

      currentIndex = index;
    }
  }

  // Hover to preview track (update display without navigation)
  tracks.forEach((track, index) => {
    track.addEventListener('mouseenter', function() {
      previewTrack(index);
    });
  });

  // Click navigates to detail page (natural link behavior - no preventDefault)

  // Navigation buttons update preview AND navigate
  document.getElementById('prev-track')?.addEventListener('click', function() {
    if (currentIndex > 0) {
      currentIndex--;
      previewTrack(currentIndex);
    }
  });

  document.getElementById('next-track')?.addEventListener('click', function() {
    if (currentIndex < tracks.length - 1) {
      currentIndex++;
      previewTrack(currentIndex);
    }
  });

  // Keyboard navigation - arrows preview, Enter navigates
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
      e.preventDefault();
      if (currentIndex > 0) previewTrack(currentIndex - 1);
    } else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
      e.preventDefault();
      if (currentIndex < tracks.length - 1) previewTrack(currentIndex + 1);
    } else if (e.key === 'Enter') {
      // Navigate to selected track's page
      if (tracks[currentIndex]) {
        window.location.href = tracks[currentIndex].href;
      }
    }
  });

  // Animated visualizer bars (simulated since SoundCloud doesn't expose audio data)
  function animateBars() {
    const bars = document.querySelectorAll('.analyzer-bars > div');
    bars.forEach((bar, i) => {
      const height = Math.random() * 80 + 10;
      bar.style.setProperty('--bar-height', height + '%');
    });
    requestAnimationFrame(animateBars);
  }
  animateBars();

  // Page loaded animation
  document.body.classList.add('mac-loaded');

  // ==========================================================================
  // GLOWING EDGE EFFECT
  // ==========================================================================

  const glowCards = document.querySelectorAll('.glow-card');

  const centerOfElement = ($el) => {
    const { width, height } = $el.getBoundingClientRect();
    return [width / 2, height / 2];
  };

  const pointerPositionRelativeToElement = ($el, e) => {
    const { left, top, width, height } = $el.getBoundingClientRect();
    const x = e.clientX - left;
    const y = e.clientY - top;
    const px = Math.min(Math.max((100 / width) * x, 0), 100);
    const py = Math.min(Math.max((100 / height) * y, 0), 100);
    return { pixels: [x, y], percent: [px, py] };
  };

  const angleFromPointerEvent = ($el, dx, dy) => {
    let angleDegrees = 0;
    if (dx !== 0 || dy !== 0) {
      const angleRadians = Math.atan2(dy, dx);
      angleDegrees = angleRadians * (180 / Math.PI) + 90;
      if (angleDegrees < 0) angleDegrees += 360;
    }
    return angleDegrees;
  };

  const distanceFromCenter = ($el, x, y) => {
    const [cx, cy] = centerOfElement($el);
    return [x - cx, y - cy];
  };

  const closenessToEdge = ($el, x, y) => {
    const [cx, cy] = centerOfElement($el);
    const [dx, dy] = distanceFromCenter($el, x, y);
    let k_x = Infinity;
    let k_y = Infinity;
    if (dx !== 0) k_x = cx / Math.abs(dx);
    if (dy !== 0) k_y = cy / Math.abs(dy);
    return Math.min(Math.max(1 / Math.min(k_x, k_y), 0), 1);
  };

  const round = (value, precision = 3) => parseFloat(value.toFixed(precision));

  glowCards.forEach(card => {
    card.addEventListener('pointermove', (e) => {
      const position = pointerPositionRelativeToElement(card, e);
      const [px, py] = position.pixels;
      const [perx, pery] = position.percent;
      const [dx, dy] = distanceFromCenter(card, px, py);
      const edge = closenessToEdge(card, px, py);
      const angle = angleFromPointerEvent(card, dx, dy);

      card.style.setProperty('--pointer-x', `${round(perx)}%`);
      card.style.setProperty('--pointer-y', `${round(pery)}%`);
      card.style.setProperty('--pointer-deg', `${round(angle)}deg`);
      card.style.setProperty('--pointer-d', `${round(edge * 100)}`);

      card.classList.remove('animating');
    });
  });

  // Intro animation for glow cards
  function playGlowAnimation(card, delay = 0) {
    const angleStart = 110;
    const angleEnd = 465;

    setTimeout(() => {
      card.style.setProperty('--pointer-deg', `${angleStart}deg`);
      card.classList.add('animating');

      // Animate pointer-d (edge closeness)
      animateValue(0, 100, 500, (v) => {
        card.style.setProperty('--pointer-d', v);
      });

      // Animate angle
      animateValue(0, 100, 1500, (v) => {
        const d = (angleEnd - angleStart) * (v / 100) + angleStart;
        card.style.setProperty('--pointer-deg', `${d}deg`);
      });

      // Fade out
      setTimeout(() => {
        animateValue(100, 0, 1500, (v) => {
          card.style.setProperty('--pointer-d', v);
        }, () => {
          card.classList.remove('animating');
        });
      }, 2000);
    }, delay);
  }

  function animateValue(start, end, duration, onUpdate, onEnd = () => {}) {
    const startTime = performance.now();
    const easeOutCubic = (x) => 1 - Math.pow(1 - x, 3);

    function update() {
      const elapsed = performance.now() - startTime;
      const t = Math.min(elapsed / duration, 1);
      const value = start + (end - start) * easeOutCubic(t);
      onUpdate(value);
      if (t < 1) {
        requestAnimationFrame(update);
      } else {
        onEnd();
      }
    }
    requestAnimationFrame(update);
  }

  // Play intro animation on each card with staggered delay
  setTimeout(() => {
    glowCards.forEach((card, i) => {
      playGlowAnimation(card, i * 300);
    });
  }, 500);
});
</script>
