<div class="news">
  {% if site.latest_posts != blank %}
    {% assign latest_posts_size = site.posts | size %}
    {% assign latest_posts = site.posts %}
    {% if site.latest_posts.limit %}
      {% assign latest_posts_limit = site.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = latest_posts_size %}
    {% endif %}
    <div
      class="table-responsive"
      {% if site.latest_posts.scrollable and latest_posts_limit > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <ul class="latest-posts">
        {% for item in latest_posts limit: latest_posts_limit %}
          <li>
            {% if item.redirect == blank %}
              <a class="news-title post-card" href="{{ item.url | relative_url }}"
                ><time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time><span>{{ item.title }}</span></a
              >
            {% elsif item.redirect contains '://' %}
              <a class="news-title post-card" href="{{ item.redirect }}" target="_blank"
                ><time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time><span>{{ item.title }}</span></a
              >
              <svg width="2rem" height="2rem" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9"
                  class="icon_svg-stroke"
                  stroke="#999"
                  stroke-width="1.5"
                  fill="none"
                  fill-rule="evenodd"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            {% else %}
              <a class="news-title post-card" href="{{ item.redirect | relative_url }}"
                ><time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %d, %Y' }}</time><span>{{ item.title }}</span></a
              >
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
