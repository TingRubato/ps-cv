<div class="pub-list">
  {% assign publications = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in publications %}
    <article class="pub-card">
      <div class="pub-meta">
        {% if content.releaseDate %}
          <span class="pub-chip pub-chip-date">{{ content.releaseDate | split: '-' | join: '.' }}</span>
        {% endif %}
        {% assign venue = content.publisher | split: ',' | first %}
        <span class="pub-chip">{{ venue }}</span>
      </div>
      <h4 class="pub-title" data-toc-skip>
        {% if content.url != blank -%}
          <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.name }}</a>
        {%- else -%}
          {{- content.name -}}
        {%- endif %}
      </h4>
      {% if content.authors %}
        <p class="pub-authors">{{ content.authors | replace: 'T. Xu', '<strong>T. Xu</strong>' }}</p>
      {% endif %}
      <p class="pub-venue">{{ content.publisher }}</p>
      {% if content.summary %}
        <p class="pub-summary">{{ content.summary }}</p>
      {% endif %}
      <div class="pub-links">
        {% if content.doi %}
          <a class="pub-btn" href="https://doi.org/{{ content.doi }}" target="_blank" rel="noopener noreferrer">DOI {{ content.doi }}</a>
        {% elsif content.url %}
          <a class="pub-btn" href="{{ content.url }}" target="_blank" rel="noopener noreferrer">Read paper &rarr;</a>
        {% endif %}
      </div>
    </article>
  {% endfor %}
</div>
