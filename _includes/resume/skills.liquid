<div class="skill-grid">
  {% for content in data[1] %}
    <section
      class="skill-card"
      {% if content.level %}
        title="{{ content.level }}"
      {% endif %}
    >
      <h3 class="skill-card-title" data-toc-skip>
        {% if content.icon %}<i class="{{ content.icon }}" aria-hidden="true"></i> {% endif -%}
        {{- content.name }}
        <span class="skill-card-count">{{ content.keywords | size }}</span>
      </h3>
      <ul class="skill-chips">
        {% for item in content.keywords %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</div>
